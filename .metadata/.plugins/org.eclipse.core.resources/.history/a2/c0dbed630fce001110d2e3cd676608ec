MTB_TYPE=PROJECT

# Select which CPU owns the BMI270 acquisition task.
# Keep exactly one owner at a time because I2C and debug UART are shared.
SENSOR_CORE ?= CM33

ifeq ($(strip $(SENSOR_CORE)),CM33)
APP_SENSOR_CORE_DEFINE=APP_SENSOR_CORE_CM33
else ifeq ($(strip $(SENSOR_CORE)),CM55)
APP_SENSOR_CORE_DEFINE=APP_SENSOR_CORE_CM55
else
$(error SENSOR_CORE must be CM33 or CM55 (got '$(SENSOR_CORE)'))
endif

DEFINES += $(APP_SENSOR_CORE_DEFINE)

# Target board/hardware (BSP).
# To change the target, it is recommended to use the Library manager
# ('make library-manager' from command line), which will also update 
# Eclipse IDE launch configurations.
TARGET=APP_KIT_PSE84_EVAL_EPC2

# Name of toolchain to use. Options include:
#
# GCC_ARM     -- GCC is available as part of ModusToolbox Setup program
# ARM         -- ARM Compiler (must be installed separately)
# IAR         -- IAR Compiler (must be installed separately)
# LLVM_ARM    -- LLVM Embedded Toolchain (must be installed separately)
#
# See also: CY_COMPILER_PATH below
TOOLCHAIN=GCC_ARM

# Default build configuration. Options include:
#
# Debug -- build with minimal optimizations, focus on debugging.
# Release -- build with full optimizations
# Custom -- build with custom configuration, set the optimization flag in CFLAGS
# 
# If CONFIG is manually edited, ensure to update or regenerate 
# launch configurations for your IDE.
CONFIG=Debug

# Sensor hub application mode selection.
# 
# Select one of them as per the required use-case.
#
# ENABLE_ACQUISITION  - Configures the application in data acquisition mode.  
#                       This is the default setting for the code example.
# ENABLE_FUSION       - Configures the application in data fusion mode. This is 
#                       an optional extension of the code example to demonstrate
#                       sensor fusion capability using Bosch's BSXlite library
#
# Ex: 
#     CONFIG_APP_MODE = ENABLE_ACQUISITION
#    or
#     CONFIG_APP_MODE = ENABLE_FUSION
# 
CONFIG_APP_MODE = ENABLE_ACQUISITION

ifeq ($(strip $(SENSOR_CORE)),CM55)
ifneq ($(strip $(CONFIG_APP_MODE)),ENABLE_ACQUISITION)
$(error SENSOR_CORE=CM55 currently supports CONFIG_APP_MODE=ENABLE_ACQUISITION only)
endif
endif

# Fusion mode is supported only with GCC_ARM toolchain
ifeq ($(strip $(CONFIG_APP_MODE)),ENABLE_FUSION)
    ifneq ($(strip $(TOOLCHAIN)),GCC_ARM)
    $(error Fusion mode is supported only by GCC_ARM \
    as the Bosch BSXlite library for CM33 CPU is only \
    available for GCC_ARM toolchain.\
    Set TOOLCHAIN=GCC_ARM to enable sensor fusion)
    endif
endif

# Config file for postbuild sign and merge operations.
# NOTE: Check the JSON file for the command parameters
COMBINE_SIGN_JSON?=configs/boot_with_extended_boot.json

include ../common_app.mk
